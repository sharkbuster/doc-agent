# 复制成 .env 再改。.env 已在 .gitignore 里，不会被提交。
#
# 默认值就是 stub：一个离线的确定性假模型，不联网、不需要任何密钥。
# 这样别人克隆下来直接 pytest 就能过，CI 里也不用配 secret。
LLM_PROVIDER=stub

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 任何 OpenAI 兼容的网关（官方、硅基流动、本地 vLLM 都行）----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 检索：hashing = 内置的字符 n-gram 向量（默认，零下载、零密钥）
#       api     = 调 OpenAI 兼容的 /embeddings 接口（更准，但要密钥和网络）
EMBEDDING_BACKEND=hashing
EMBEDDING_DIM=1024

# 只有 EMBEDDING_BACKEND=api 时才需要下面三项。
# 注意：DeepSeek 没有 embeddings 接口，别把它的 key 填在这里。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

RETRIEVAL_TOP_K=5

# 检索最高余弦分低于这个值就判定「知识库里没有」，走拒答而不是硬编
REFUSAL_THRESHOLD=0.35
