# 复制成 .env 再改。.env 已在 .gitignore 里，不会被提交。
#
# 默认值就是 stub：一个离线的确定性假模型，不联网、不需要任何密钥。
# 这样别人克隆下来直接 pytest 就能过，CI 里也不用配 secret。
LLM_PROVIDER=stub

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 官方当前的模型名。旧的 deepseek-chat 仍然接受，按同一个价格计费。
DEEPSEEK_MODEL=deepseek-flash

# ---- 任何 OpenAI 兼容的网关（官方、硅基流动、本地 vLLM 都行）----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 检索：hashing = 内置的字符 n-gram 向量（默认，零下载、零密钥）
#       api     = 调 OpenAI 兼容的 /embeddings 接口（更准，但要密钥和网络）
EMBEDDING_BACKEND=hashing
EMBEDDING_DIM=1024

# 只有 EMBEDDING_BACKEND=api 时才需要下面三项。
# 注意：DeepSeek 没有 embeddings 接口，别把它的 key 填在这里。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# lexical / hybrid / dense。默认 lexical 是 scripts/calibrate.py 扫出来的结论：
# 内置的哈希向量在这份语料上任何权重都跑不赢 BM25。接了真实嵌入模型后应改回 hybrid。
RETRIEVAL_MODE=lexical
DENSE_WEIGHT=0.0
RETRIEVAL_TOP_K=5

# 拒答判据：coverage（问题里的词组有没有出现在召回的条款里，IDF 加权）
#           dense（稠密余弦。实测区分度差，不推荐）
REFUSAL_SIGNAL=coverage
REFUSAL_THRESHOLD=0.05
